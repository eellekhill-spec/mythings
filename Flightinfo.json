"""
Flight Tracker Application
Sources flights headed to Canada, Mexico, Europe, and Africa using Free APIs
"""

import requests
import json
from datetime import datetime
from typing import List, Dict, Optional
import os

# Region to country mapping
REGIONS = {
    'Canada': ['CA'],
    'Mexico': ['MX'],
    'Europe': [
        'GB', 'FR', 'DE', 'IT', 'ES', 'NL', 'BE', 'CH', 'AT', 'SE', 
        'NO', 'DK', 'FI', 'PL', 'PT', 'GR', 'CZ', 'IE', 'RO', 'HU'
    ],
    'Africa': [
        'EG', 'ZA', 'NG', 'KE', 'MA', 'TN', 'GH', 'ET', 'TZ', 'UG',
        'DZ', 'SD', 'AO', 'MZ', 'MG', 'CM', 'CI', 'NE', 'BF', 'ML'
    ]
}


class FlightTracker:
    """Flight Tracker using Aviationstack API"""
    
    def __init__(self, api_key: str):
        """
        Initialize Flight Tracker
        
        Args:
            api_key: Aviationstack API key (get free at https://aviationstack.com)
        """
        self.api_key = api_key
        self.base_url = "http://api.aviationstack.com/v1"
        
    def get_flights(self, limit: int = 100) -> Optional[List[Dict]]:
        """
        Fetch real-time flight data
        
        Args:
            limit: Maximum number of flights to retrieve
            
        Returns:
            List of flight dictionaries or None if error
        """
        endpoint = f"{self.base_url}/flights"
        params = {
            'access_key': self.api_key,
            'limit': limit
        }
        
        try:
            response = requests.get(endpoint, params=params, timeout=10)
            response.raise_for_status()
            data = response.json()
            
            if 'data' in data:
                return data['data']
            else:
                print(f"Error: {data.get('error', {}).get('info', 'Unknown error')}")
                return None
                
        except requests.exceptions.RequestException as e:
            print(f"Request failed: {e}")
            return None
    
    def filter_flights_by_region(self, flights: List[Dict], regions: List[str]) -> Dict[str, List[Dict]]:
        """
        Filter flights by destination regions
        
        Args:
            flights: List of flight data
            regions: List of region names to filter by
            
        Returns:
            Dictionary with regions as keys and filtered flights as values
        """
        filtered = {region: [] for region in regions}
        
        for flight in flights:
            # Get arrival country code
            arrival = flight.get('arrival', {})
            country_code = arrival.get('iata', '')[:2] if arrival.get('iata') else None
            
            # Alternative: check timezone or airport info
            if not country_code and arrival.get('timezone'):
                # Parse country from timezone (e.g., "America/Toronto" -> CA)
                timezone = arrival.get('timezone', '')
                if 'America' in timezone and ('Toronto' in timezone or 'Vancouver' in timezone or 'Montreal' in timezone):
                    country_code = 'CA'
                elif 'America/Mexico' in timezone:
                    country_code = 'MX'
            
            # Check which region this country belongs to
            for region in regions:
                if country_code in REGIONS.get(region, []):
                    filtered[region].append(flight)
                    break
        
        return filtered
    
    def format_flight_info(self, flight: Dict) -> str:
        """
        Format flight information for display
        
        Args:
            flight: Flight data dictionary
            
        Returns:
            Formatted string with flight details
        """
        # Extract data safely
        flight_date = flight.get('flight_date', 'N/A')
        flight_status = flight.get('flight_status', 'N/A').upper()
        
        # Flight info
        flight_info = flight.get('flight', {})
        flight_number = flight_info.get('iata', 'N/A')
        
        # Airline
        airline = flight.get('airline', {})
        airline_name = airline.get('name', 'Unknown Airline')
        
        # Departure
        departure = flight.get('departure', {})
        dep_airport = departure.get('airport', 'Unknown')
        dep_iata = departure.get('iata', 'N/A')
        dep_time = departure.get('scheduled', 'N/A')
        
        # Arrival
        arrival = flight.get('arrival', {})
        arr_airport = arrival.get('airport', 'Unknown')
        arr_iata = arrival.get('iata', 'N/A')
        arr_time = arrival.get('scheduled', 'N/A')
        
        return f"""
Flight: {flight_number} | {airline_name}
Status: {flight_status}
From: {dep_airport} ({dep_iata}) at {dep_time}
To:   {arr_airport} ({arr_iata}) at {arr_time}
Date: {flight_date}
{'='*60}"""


class AirLabsTracker:
    """Alternative tracker using AirLabs API (free tier available)"""
    
    def __init__(self, api_key: str):
        """
        Initialize AirLabs Tracker
        
        Args:
            api_key: AirLabs API key (get free at https://airlabs.co)
        """
        self.api_key = api_key
        self.base_url = "https://airlabs.co/api/v9"
    
    def get_flights(self, limit: int = 100) -> Optional[List[Dict]]:
        """Fetch real-time flight data from AirLabs"""
        endpoint = f"{self.base_url}/flights"
        params = {
            'api_key': self.api_key
        }
        
        try:
            response = requests.get(endpoint, params=params, timeout=10)
            response.raise_for_status()
            data = response.json()
            
            if 'response' in data:
                return data['response'][:limit]
            return None
                
        except requests.exceptions.RequestException as e:
            print(f"AirLabs request failed: {e}")
            return None


def display_results(filtered_flights: Dict[str, List[Dict]], tracker):
    """
    Display filtered flight results
    
    Args:
        filtered_flights: Dictionary of flights by region
        tracker: FlightTracker instance for formatting
    """
    print("\n" + "="*60)
    print("FLIGHT TRACKER - Destinations: Canada, Mexico, Europe, Africa")
    print("="*60)
    
    total_flights = sum(len(flights) for flights in filtered_flights.values())
    print(f"\nTotal flights found: {total_flights}\n")
    
    for region, flights in filtered_flights.items():
        if flights:
            print(f"\n{'#'*60}")
            print(f"REGION: {region.upper()} ({len(flights)} flights)")
            print(f"{'#'*60}")
            
            for i, flight in enumerate(flights, 1):
                print(f"\n[{i}] {tracker.format_flight_info(flight)}")
        else:
            print(f"\n{region}: No flights found")


def main():
    """Main application entry point"""
    print("="*60)
    print("FLIGHT TRACKER APPLICATION")
    print("="*60)
    print("\nThis app tracks flights to Canada, Mexico, Europe, and Africa")
    print("using free flight data APIs.\n")
    
    # Check for API key in environment variable
    api_key = os.environ.get('AVIATIONSTACK_API_KEY')
    
    if not api_key:
        print("Please enter your Aviationstack API key.")
        print("Get a free key at: https://aviationstack.com/product")
        print("(100 free requests/month)\n")
        api_key = input("API Key: ").strip()
        
        if not api_key:
            print("\nError: API key is required!")
            print("\nTo use this app:")
            print("1. Sign up at https://aviationstack.com")
            print("2. Get your free API key")
            print("3. Set environment variable: export AVIATIONSTACK_API_KEY='your_key'")
            print("   OR enter it when prompted")
            return
    
    # Initialize tracker
    print("\nInitializing Flight Tracker...")
    tracker = FlightTracker(api_key)
    
    # Fetch flights
    print("Fetching flight data...")
    flights = tracker.get_flights(limit=100)
    
    if not flights:
        print("\nFailed to fetch flight data. Please check:")
        print("- Your API key is valid")
        print("- You haven't exceeded the free tier limit (100 requests/month)")
        print("- Your internet connection is working")
        return
    
    print(f"Retrieved {len(flights)} flights")
    
    # Filter by regions
    print("\nFiltering flights by destination regions...")
    regions = ['Canada', 'Mexico', 'Europe', 'Africa']
    filtered = tracker.filter_flights_by_region(flights, regions)
    
    # Display results
    display_results(filtered, tracker)
    
    # Save to file option
    save = input("\n\nSave results to JSON file? (y/n): ").strip().lower()
    if save == 'y':
        filename = f"flights_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        with open(filename, 'w') as f:
            json.dump(filtered, f, indent=2)
        print(f"\nResults saved to: {filename}")
    
    print("\n" + "="*60)
    print("Flight tracking complete!")
    print("="*60)


if __name__ == "__main__":
    main()
